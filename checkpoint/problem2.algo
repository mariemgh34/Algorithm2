PROCEDURE dot_product(v1,v2: ARRAY_OF INTEGER[n];n: INTEGER, VAR ps:INTEGER )
VAR
    
    n:INTEGER:=0
    
BEGIN
    FOR i FROM 0 TO n-1 STEP 1  DO
        ps:=ps+v1[i]*v2[i]
    END_FOR
END
ALGORITHM orthogonal_vectors
VAR
    v1,v2: ARRAY_OF type[n];
    ps:INTEGER
BEGIN
    FOR i FROM 0 TO n-1 STEP 1  DO
        Read(v1[i])
    END_FOR
    FOR i FROM 0 TO n-1 STEP 1  DO
        Read(v2[i])
    END_FOR
    // dot_product(v1,v2,n,ps)
    ps:=Is_orthogonal(v1,v2,n)
    IF (ps==0) THEN
        Write("yes")
    ELSE
        Write("no")
    END_IF


END
FUNCTION Is_orthogonal(v1,v2: ARRAY_OF type[n]; n:INTEGER) : INTEGER
VAR
    i,ps: INTEGER:=0
BEGIN
    FOR i FROM 0 TO n-1 STEP 1  DO
        ps:=ps+v1[i]*v2[i]
    END_FOR
    RETURN ps ;
END
