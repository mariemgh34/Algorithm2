ALGORITHM sumofelts
VAR
    a:INTEGER
    b:INTEGER
    set1 : ARRAY_OF INTEGER[a];
    set2 : ARRAY_OF INTEGER[b];
    s:INTEGER:=0;

BEGIN
    Read(a);
    Read(b);
    FOR i FROM 0 TO a-1 STEP 1  DO
        Write(set1[i])
    END_FOR
    FOR j FROM 0 TO b-1 STEP 1  DO
        Write(set2[j])
    END_FOR
    FOR i FROM 0 TO a-1 STEP  1  DO
        found:=false
        FOR j FROM 0 TO b-1 STEP 1  DO
            IF (set1[i]==set2[j]) THEN
                found=true;
                Break;
            
                
            END_IF
            IF (found==false) THEN
                s:=s+set1[i]
            END_IF
        END_FOR
        
    END_FOR
    FOR i FROM 0 TO b-1 STEP  1  DO
        found:=false
        FOR j FROM 0 TO b-1 STEP 1  DO
            IF (set1[i]==set2[j]) THEN
                found=true;
                Break;
            
                
            END_IF
            IF (found==false) THEN
                s:=s+set2[i]
            END_IF
        END_FOR
        
    END_FOR
END